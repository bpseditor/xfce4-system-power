{
  "interval": 5,
  "panel_interval": 5,
  "warning_temperature": 80,
  "warning_memory": 90,
  "warning_battery": 20,
  "warning_color": "#df8585",
  "compact": true,
  "metric_order": "power,cpu,memory,temperature,network,runtime,swap,disk",
  "show_cpu": true,
  "show_memory": true,
  "show_temperature": true,
  "show_network": true,
  "show_power": true,
  "show_runtime": false,
  "show_swap": false,
  "show_disk": false,
  "interface": "auto",
  "network_units": "KiB/s",
  "memory_units": "GiB",
  "disk_path": "/",
  "average_samples": 24,
  "separator": " \u00b7 ",
  "accent": "#e0ded8",
  "tooltip": true,
  "panel_font": "Monospace 9"
}
