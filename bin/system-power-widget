#!/usr/bin/python3
"""Low-overhead XFCE genmon monitor; all measurements are read-only."""
import os, sys, json, time, html, shutil, statistics
from pathlib import Path
os.umask(0o077)
BAT = Path('/sys/class/power_supply/BAT0')
RUNTIME = Path(os.environ.get('XDG_RUNTIME_DIR', '/tmp')) / ('system-power-' + str(os.getuid()))
RUNTIME.mkdir(mode=0o700, exist_ok=True)
if RUNTIME.stat().st_uid != os.getuid():
    raise RuntimeError('Unsafe runtime directory')
CACHE = RUNTIME / (f'dashboard-{os.getpid()}.json' if '--window' in sys.argv else 'panel.json')

CONFIG = Path.home()/'.config/system-power-widget/settings.json'
DEFAULTS = dict(interval=5, panel_interval=5, warning_temperature=80, warning_memory=90, warning_battery=20, warning_color="#df8585", compact=False, metric_order="power,cpu,memory,temperature,network,runtime,swap,disk", show_cpu=True, show_memory=True, show_temperature=True, show_network=False, show_power=True, show_runtime=False, show_swap=False, show_disk=False, interface="auto", network_units="KiB/s", memory_units="percent", disk_path="/", average_samples=24, separator="  ·  ", accent="#bfbdb6", tooltip=True)
def settings():
    try: stored=json.loads(CONFIG.read_text())
    except (OSError,ValueError): stored={}
    cfg=DEFAULTS.copy()
    if not isinstance(stored,dict): stored={}
    for key,val in stored.items():
        if key in cfg and type(val) is type(cfg[key]): cfg[key]=val
    cfg['interval']=max(2,min(30,cfg['interval']))
    cfg['panel_interval']=max(2,min(30,cfg['panel_interval']))
    for key,lo,hi in [('warning_temperature',40,110),('warning_memory',50,100),('warning_battery',5,50)]: cfg[key]=max(lo,min(hi,cfg[key]))
    cfg['average_samples']=max(1,min(120,cfg['average_samples']))
    import re
    for key in ('accent','warning_color'):
        if not re.fullmatch(r'#[0-9a-fA-F]{6}',cfg[key]): cfg[key]=DEFAULTS[key]
    return cfg

def read(p, default='—'):
    try: return Path(p).read_text().strip()
    except (OSError, ValueError): return default

def num(p, scale=1):
    try: return float(read(p)) / scale
    except ValueError: return None

def fmt(n, unit='', digits=1):
    return '—' if n is None else f'{n:.{digits}f}{unit}'

def duration(hours):
    if hours is None or hours < 0: return '—'
    return f'{int(hours * 60) // 60} h {int(hours * 60) % 60:02d} min'

def panel_field(value, width):
    """Bound a cell even for an unexpected reading; details stay in the tooltip."""
    value=str(value)
    if len(value)>width: value=value[:width-1]+'…'
    return value.rjust(width)

def panel_network(name, width, unit, rx=None, tx=None):
    # The interface name and full units remain in the Network tooltip.
    def rate(value):
        if value is None: return panel_field('—',5)
        suffixes={'KiB/s':['K','M','G','T'], 'MiB/s':['M','G','T'],
                  'Mbit/s':['Mb','Gb','Tb']}.get(unit,['K','M','G','T'])
        factor=1000 if unit=='Mbit/s' else 1024
        for suffix in suffixes:
            digits=1 if value<(9.95 if len(suffix)==2 else 99.95) else 0
            text=f'{value:.{digits}f}{suffix}'
            if len(text)<=5: return panel_field(text,5)
            value/=factor
        return panel_field('>max',5)
    return f'↓{rate(rx)}/s ↑{rate(tx)}/s'

def panel_metrics(cfg, *, status, ac, percent, power, busy, used, mt, swap,
                  swap_total, cpu_temp, disk_percent, eta, network):
    def number(value, width, digits=0):
        return panel_field(fmt(value,digits=digits),width)
    source='AC' if ac or status=='Charging' else 'BAT'
    flow=('+' if status=='Charging' else '−')+number(power,4,1 if power is None or power<99.95 else 0)+'W' if status in ('Charging','Discharging') else ' '*6
    # Reserve charging/discharging space even when the battery is idle or absent.
    values=dict(
        power=f'{source:<3} BAT {number(percent,3)}% PWR {flow}',
        cpu=f'CPU {number(busy,3)}%',
        memory=(f'RAM {number(used/mt*100,3)}%' if cfg['memory_units']=='percent'
                else f'RAM {number(used,len(f"{mt:.1f}"),1)} GiB'),
        swap=f'SWAP {number(swap,len(f"{swap_total:.1f}"),1)} GiB',
        disk=f'DISK {number(disk_percent,3)}%',
        temperature='TEMP '+number(cpu_temp,3)+'°C',
        runtime='ETA '+(f'{int(eta):2d}:{int(eta*60)%60:02d}' if eta is not None and 0<=eta<100
                        else (' >99h' if eta is not None and eta>=100 else '  —  ')),
        network='NET '+network,
    )
    if cfg['compact']:
        values={k:v.replace('CPU ','C ').replace('RAM ','M ').replace('DISK ','D ').replace('SWAP ','S ').replace('ETA ','') for k,v in values.items()}
    return values

def sample(panel_mode=False):
    cfg=settings()
    now = time.monotonic()
    try: prev = json.loads(CACHE.read_text())
    except (OSError, ValueError): prev = {}
    elapsed = now - prev.get('t', now)
    valid = 0.2 < elapsed < 120
    cpu = [int(x) for x in read('/proc/stat').splitlines()[0].split()[1:9]]
    total, idle = sum(cpu), cpu[3]+cpu[4]
    delta = total - prev.get('cpu', total)
    busy = max(0, min(100, 100*(1-(idle-prev.get('idle',idle))/delta))) if valid and delta > 0 else None
    mem = {}
    for line in read('/proc/meminfo').splitlines():
        k,v = line.split(':',1); mem[k] = int(v.strip().split()[0])
    used = (mem['MemTotal']-mem['MemAvailable'])/1048576
    mt = mem['MemTotal']/1048576
    swap = (mem['SwapTotal']-mem['SwapFree'])/1048576
    net, netrows, panel_net = {}, [], {}
    interfaces=sorted(p for p in Path('/sys/class/net').iterdir() if p.name!='lo')
    interface_width=max([len(cfg['interface']) if cfg['interface']!='auto' else 0]+[len(p.name) for p in interfaces]+[1])
    unit=cfg['network_units']
    def network_cell(name,rx=None,tx=None):
        return panel_network(name,interface_width,unit,rx,tx)
    for p in interfaces:
        rx,tx = num(p/'statistics/rx_bytes'),num(p/'statistics/tx_bytes')
        if rx is None or tx is None: continue
        net[p.name] = [rx,tx]
        if read(p/'operstate') not in ('up','unknown'): continue
        old = prev.get('net',{}).get(p.name)
        speed = ''
        panel_rx=panel_tx=None
        if valid and old:
            unit=cfg['network_units'];factor={'KiB/s':1024,'MiB/s':1048576,'Mbit/s':125000}.get(unit,1024)
            panel_rx,panel_tx=max(0,rx-old[0])/elapsed/factor,max(0,tx-old[1])/elapsed/factor
            speed=f' ↓ {panel_rx:.1f} ↑ {panel_tx:.1f} {unit}'
        netrows.append(p.name+speed)
        panel_net[p.name]=network_cell(p.name,panel_rx,panel_tx)
    status = read(BAT/'status')
    ac = any(read(p/'online') == '1' for p in Path('/sys/class/power_supply').iterdir() if read(p/'type') != 'Battery')
    power,energy,full,design = [num(BAT/f,1e6) for f in ['power_now','energy_now','energy_full','energy_full_design']]
    percent = num(BAT/'capacity')
    start,end = num(BAT/'charge_control_start_threshold'),num(BAT/'charge_control_end_threshold')
    history = prev.get('power',[]) if valid and prev.get('status') == status and prev.get('ac') == ac else []
    if power is not None: history = (history + [[now,power]])[-cfg['average_samples']:]
    smooth = statistics.mean(x[1] for x in history) if history else None
    eta = energy/smooth if status == 'Discharging' and energy is not None and smooth and smooth > 0.5 else None
    temps,fan = [],[]
    for hw in sorted(Path('/sys/class/hwmon').glob('hwmon*')):
        name = read(hw/'name')
        for p in sorted(hw.glob('temp*_input')):
            val=num(p,1000)
            if val is not None and 0 < val < 120:
                label=read(p.with_name(p.name.replace('_input','_label')),name)
                friendly={'k10temp':'CPU','amdgpu':'GPU','nvme':'SSD','iwlwifi_1':'Wi-Fi','thinkpad':'CPU (EC)'}.get(name,label)
                if name != 'thinkpad': temps.append(f'{friendly}: {val:.0f} °C')
        for p in hw.glob('fan*_input'):
            v=num(p)
            if v is not None: fan.append(f'{v:.0f} RPM')
    freqs=[num(p,1000) for p in Path('/sys/devices/system/cpu').glob('cpu[0-9]*/cpufreq/scaling_cur_freq')]
    freqs=[v for v in freqs if v is not None]
    try: disk=shutil.disk_usage(cfg['disk_path'])
    except OSError: disk=shutil.disk_usage('/')
    bright=[]
    for p in Path('/sys/class/backlight').iterdir():
        v,m=num(p/'brightness'),num(p/'max_brightness')
        if v is not None and m: bright.append(f'{v/m*100:.0f}%')
    uptime=float(read('/proc/uptime','0 0').split()[0])
    state={'Charging':'charging','Discharging':'discharging','Not charging':'AC power','Full':'fully charged'}.get(status,status)
    if status=='Charging':
        flow=f'Into battery: {fmt(power," W")} (average {fmt(smooth," W")})'
        label=f'AC {fmt(percent,"%",0)}  +{fmt(power,"W")}'
    elif status=='Discharging':
        flow=f'From battery: {fmt(power," W")} (average {fmt(smooth," W")})'
        label=f'BAT {fmt(percent,"%",0)}  −{fmt(power,"W")}'
    else:
        flow=f'Battery flow: {fmt(power," W")}'
        label=f'{"AC" if ac else "BAT"} {fmt(percent,"%",0)}'
    rows=[
      ('Power source',f'{"Adapter connected" if ac else "Running on battery"} · {state}'),
      ('Power flow',flow),
      ('Estimated runtime', duration(eta) if eta is not None else '— (available while discharging)'),
      ('Stored energy',f'{fmt(energy," Wh")} / {fmt(full," Wh")}'),
      ('Charge thresholds',f'Start {fmt(start,"%",0)} · stop {fmt(end,"%",0)}'),
      ('Battery',f'{read(BAT/"manufacturer")} {read(BAT/"model_name")} · {read(BAT/"cycle_count")} cycles'),
      ('Reported capacity',f'{fmt(full/design*100 if full and design else None,"%")} of design {fmt(design," Wh")}'),
      ('Voltage',fmt(num(BAT/'voltage_now',1e6),' V')),
      ('CPU',f'{fmt(busy,"%",0)} · frequency {fmt(statistics.mean(freqs) if freqs else None," MHz",0)}'),
      ('Load 1 / 5 / 15 min',' / '.join(f'{v:.2f}' for v in os.getloadavg())),
      ('Temperatures',' · '.join(temps) or '—'),
      ('Fan',' · '.join(dict.fromkeys(fan)) or '—'),
      ('Memory',f'{used:.1f} / {mt:.1f} GiB ({used/mt*100:.0f}%)'),
      ('Swap',f'{swap:.1f} / {mem["SwapTotal"]/1048576:.1f} GiB'),
      ('Disk '+cfg['disk_path'],f'Free {disk.free/2**30:.1f} GiB · used {disk.used/disk.total*100:.0f}%'),
      ('Network','\n'.join(netrows) or 'No active interfaces'),
      ('Brightness',' · '.join(bright) or '—'),
      ('Uptime',duration(uptime/3600)),
      ('CPU governor',read('/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor')),
      ('CPU limit',fmt(num('/sys/devices/system/cpu/cpu0/cpufreq/scaling_max_freq',1000),' MHz',0)),
      ('GPU',read('/sys/class/drm/card0/device/power_dpm_force_performance_level')),
    ]
    note='On AC, watts measure battery charging, not wall power.\nRuntime depends on workload. Reported capacity is a controller estimate.\nCharge thresholds show the current controller settings.'
    data={'t':now,'cpu':total,'idle':idle,'net':net,'power':history,'status':status,'ac':ac}
    tmp=CACHE.with_suffix('.tmp');tmp.write_text(json.dumps(data));tmp.replace(CACHE)
    cfg = settings()
    cpu_temp = next((num(p,1000) for hw in Path('/sys/class/hwmon').glob('hwmon*') if read(hw/'name')=='k10temp' for p in hw.glob('temp*_input')), None)
    metrics=dict(power=label, runtime='ETA '+duration(eta), swap=f'SWAP {swap:.1f}G', disk=f'DISK {disk.used/disk.total*100:.0f}%', cpu=f'CPU {fmt(busy,"%",0)}', memory=f'RAM {used/mt*100:.0f}%' if cfg['memory_units']=='percent' else f'RAM {used:.1f}G', temperature=fmt(cpu_temp,'°',0))
    selected=cfg['interface']
    if selected=='auto':
        routes=read('/proc/net/route','').splitlines()[1:]
        selected=next((line.split()[0] for line in routes if len(line.split())>1 and line.split()[1]=='00000000'), '')
    network=next((x for x in netrows if x.split()[0]==selected), (netrows[0] if cfg['interface']=='auto' and netrows else selected+' unavailable'))
    metrics['network']=network
    if panel_mode:
        network_name=network.split()[0] if netrows or selected else '—'
        metrics=panel_metrics(cfg,status=status,ac=ac,percent=percent,power=power,busy=busy,
                              used=used,mt=mt,swap=swap,swap_total=mem['SwapTotal']/1048576,
                              cpu_temp=cpu_temp,disk_percent=disk.used/disk.total*100,eta=eta,
                              network=panel_net.get(network_name,network_cell(network_name)))
    order=list(dict.fromkeys(cfg['metric_order'].split(',')+DEFAULTS['metric_order'].split(',')))
    pieces=[metrics[k] for k in order if k in metrics and cfg.get('show_'+k,False)]
    if cfg['compact'] and not panel_mode:
        pieces=[v.replace('CPU ','C ').replace('RAM ','M ').replace('DISK ','D ').replace('SWAP ','S ') for v in pieces]
    warning=(cpu_temp is not None and cpu_temp>=cfg['warning_temperature']) or used/mt*100>=cfg['warning_memory'] or (status=='Discharging' and percent is not None and percent<=cfg['warning_battery'])
    if warning and not panel_mode: pieces.insert(0,'⚠')
    sample.warning=warning
    rows[15]=('Network', 'Selected: '+network+'\n\n'+'\n'.join(netrows))
    separator=(' '+cfg['separator'].strip()+' ' if cfg['separator'].strip() else ' ') if panel_mode else cfg['separator']
    return separator.join(pieces) or 'System',rows,note

def panel():
    label,rows,note=sample(panel_mode=True)
    tip='\n'.join(f'{k}: {v}' for k,v in rows)+'\n\n'+note+'\nClick to open System & Power.'
    cfg=settings()
    color=cfg['warning_color'] if getattr(sample,'warning',False) else cfg['accent']
    if not settings()['tooltip']: tip='Click to open System & Power.'
    warning_alpha=65535 if getattr(sample,'warning',False) else 1
    print(f'<txt><span font_family="monospace" font_desc="JetBrains Mono Medium 10" foreground="{color}">'
          f'<span alpha="{warning_alpha}">⚠</span> {html.escape(label)}</span></txt>'
          f'<txtclick>{html.escape(str(Path.home()/".local/bin/system-power-widget"))} --window</txtclick>'
          f'<tool>{html.escape(tip)}</tool>')


def window():
    import gi, subprocess
    gi.require_version('Gtk','3.0')
    from gi.repository import Gtk,GLib,Gio,Gdk
    app=Gtk.Application(application_id='local.user.SystemPowerWidget', flags=Gio.ApplicationFlags.FLAGS_NONE)
    def activate(app):
        if app.get_active_window():
            app.get_active_window().present();return
        cfg=settings()
        win=Gtk.ApplicationWindow(application=app,title='System & Power')
        win.set_default_size(860,760)
        win.set_icon_name('utilities-system-monitor')
        outer=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=16,margin=22)
        win.add(outer)
        title=Gtk.Label(xalign=0)
        title.set_markup('<span size="x-large" weight="bold">System &amp; Power</span>')
        outer.pack_start(title,False,False,0)
        subtitle=Gtk.Label(label='SYSTEM  /  LIVE TELEMETRY',xalign=0)
        subtitle.get_style_context().add_class('dim-label');outer.pack_start(subtitle,False,False,0)
        summary=Gtk.Label(xalign=0)
        summary.set_line_wrap(True);summary.set_max_width_chars(85)
        summary.set_margin_top(6);summary.set_margin_bottom(6)
        outer.pack_start(summary,False,False,0)
        notebook=Gtk.Notebook();outer.pack_start(notebook,True,True,0)
        _,rows,note=sample()
        labels={}
        groups=[('Power',range(0,8)),('System',list(range(8,15))+list(range(16,21))),('Network',[15])]
        for name,indices in groups:
            scroll=Gtk.ScrolledWindow();scroll.set_policy(Gtk.PolicyType.NEVER,Gtk.PolicyType.AUTOMATIC)
            grid=Gtk.Grid(column_spacing=26,row_spacing=14,margin=18)
            scroll.add(grid);notebook.append_page(scroll,Gtk.Label(label=name))
            for i,index in enumerate(indices):
                k,v=rows[index]
                key=Gtk.Label(label=k,xalign=0);key.set_valign(Gtk.Align.START);key.get_style_context().add_class('dim-label')
                val=Gtk.Label(label=v,xalign=0);val.set_line_wrap(True);val.set_max_width_chars(55);val.set_hexpand(True)
                grid.attach(key,0,i,1,1);grid.attach(val,1,i,1,1);labels[index]=val
            if name=='Power':
                info=Gtk.Label(label=note,xalign=0);info.set_line_wrap(True);info.set_max_width_chars(82)
                info.get_style_context().add_class('dim-label');info.set_margin_top(12);grid.attach(info,0,9,2,1)
                # Charge thresholds above reflect the active machine's controller.
            if name=='Network':
                info=Gtk.Label(label='Rates are per interface. VPN and physical traffic overlap;\nthey are intentionally not added together.',xalign=0)
                info.get_style_context().add_class('dim-label');grid.attach(info,0,2,2,1)
        settings_box=Gtk.Box(orientation=Gtk.Orientation.VERTICAL,spacing=14,margin=18)
        sc=Gtk.ScrolledWindow();sc.add(settings_box);notebook.append_page(sc,Gtk.Label(label='Settings'))
        controls={}
        for key,caption in [('show_cpu','CPU usage in panel'),('show_memory','Memory usage in panel'),('show_temperature','CPU temperature in panel'),('show_network','Network speed in panel'),('show_power','Battery and power in panel'),('show_runtime','Runtime estimate in panel'),('show_swap','Swap usage in panel'),('show_disk','Disk usage in panel'),('tooltip','Detailed panel tooltip'),('compact','Compact panel labels')]:
            row=Gtk.Box(spacing=16);lab=Gtk.Label(label=caption,xalign=0);row.pack_start(lab,True,True,0)
            sw=Gtk.Switch();sw.set_active(cfg[key]);row.pack_end(sw,False,False,0);controls[key]=sw
            settings_box.pack_start(row,False,False,0)
        row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label='Dashboard refresh interval (seconds)',xalign=0),True,True,0)
        spin=Gtk.SpinButton.new_with_range(2,30,1);spin.set_value(cfg['interval']);row.pack_end(spin,False,False,0)
        settings_box.pack_start(row,False,False,0)
        extra_spins={}
        for key,caption,lo,hi in [('panel_interval','Panel refresh interval (seconds)',2,30),('warning_temperature','Temperature warning (°C)',40,110),('warning_memory','Memory warning (%)',50,100),('warning_battery','Low battery warning (%)',5,50)]:
            row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label=caption,xalign=0),True,True,0)
            field=Gtk.SpinButton.new_with_range(lo,hi,1);field.set_value(cfg[key]);row.pack_end(field,False,False,0)
            settings_box.pack_start(row,False,False,0);extra_spins[key]=field
        choices={}
        def choice(key,caption,values):
            row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label=caption,xalign=0),True,True,0)
            combo=Gtk.ComboBoxText()
            for value in dict.fromkeys(values+[cfg[key]]):combo.append(value,value)
            combo.set_active_id(cfg[key]);row.pack_end(combo,False,False,0)
            settings_box.pack_start(row,False,False,0);choices[key]=combo
        choice('interface','Network interface',['auto']+[p.name for p in sorted(Path('/sys/class/net').iterdir()) if p.name!='lo'])
        choice('network_units','Network rate units',['KiB/s','MiB/s','Mbit/s'])
        choice('memory_units','Panel memory format',['percent','GiB'])
        choice('separator','Panel separator',['  ·  ','  |  ','    '])
        entries={}
        for key,caption in [('disk_path','Disk mount or directory'),('metric_order','Order: power,cpu,memory,temperature,network,runtime,swap,disk')]:
            row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label=caption,xalign=0),True,True,0)
            lab=row.get_children()[0];lab.set_line_wrap(True);lab.set_max_width_chars(40)
            entry=Gtk.Entry();entry.set_text(cfg[key]);row.pack_end(entry,False,False,0)
            settings_box.pack_start(row,False,False,0);entries[key]=entry
        row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label='Power averaging samples',xalign=0),True,True,0)
        average=Gtk.SpinButton.new_with_range(1,120,1);average.set_value(cfg['average_samples']);row.pack_end(average,False,False,0);settings_box.pack_start(row,False,False,0)
        row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label='Panel accent colour',xalign=0),True,True,0)
        colour=Gtk.ColorButton();rgba=Gdk.RGBA();rgba.parse(cfg['accent']);colour.set_rgba(rgba);row.pack_end(colour,False,False,0);settings_box.pack_start(row,False,False,0)
        warning_colour=Gtk.ColorButton();rgba=Gdk.RGBA();rgba.parse(cfg['warning_color']);warning_colour.set_rgba(rgba)
        row=Gtk.Box(spacing=16);row.pack_start(Gtk.Label(label='Warning colour',xalign=0),True,True,0);row.pack_end(warning_colour,False,False,0);settings_box.pack_start(row,False,False,0)
        status=Gtk.Label(xalign=0);status.set_line_wrap(True)
        timer=[None]
        def update():
            label,data,_=sample()
            summary.set_markup('<span foreground="'+settings()['accent']+'" weight="bold">'+html.escape(label)+'</span>')
            for i,lab in labels.items(): lab.set_text(data[i][1])
            return True
        def save(button):
            order=[v.strip() for v in entries['metric_order'].get_text().split(',')]
            if len(order)!=8 or set(order)!=set(DEFAULTS['metric_order'].split(',')):
                status.set_text('Order must contain each of the eight metric names exactly once.');return
            cfg.update({k:sw.get_active() for k,sw in controls.items()})
            if not Path(entries['disk_path'].get_text()).is_dir():
                status.set_text('Choose an existing directory for disk usage.');return
            cfg.update({k:c.get_active_id() for k,c in choices.items()})
            cfg.update({k:e.get_text().strip() for k,e in entries.items()})
            cfg['metric_order']=','.join(order)
            cfg.update({k:w.get_value_as_int() for k,w in extra_spins.items()})
            rgba=warning_colour.get_rgba();cfg['warning_color']='#%02x%02x%02x'%tuple(round(v*255) for v in [rgba.red,rgba.green,rgba.blue])
            cfg['average_samples']=average.get_value_as_int()
            rgba=colour.get_rgba();cfg['accent']='#%02x%02x%02x'%tuple(round(v*255) for v in [rgba.red,rgba.green,rgba.blue])
            cfg['interval']=spin.get_value_as_int()
            CONFIG.parent.mkdir(parents=True,exist_ok=True)
            tmp=CONFIG.with_suffix('.tmp');tmp.write_text(json.dumps(cfg,indent=2));tmp.replace(CONFIG)
            if timer[0]: GLib.source_remove(timer[0])
            timer[0]=GLib.timeout_add_seconds(cfg['interval'],update)
            listing=subprocess.run(['xfconf-query','-c','xfce4-panel','-lv'],capture_output=True,text=True)
            commands=[line.split(None,1)[0].rsplit('/',1)[0] for line in listing.stdout.splitlines() if '/command' in line and 'system-power-widget' in line]
            result=subprocess.CompletedProcess([],1,stderr='No System & Power panel instance found.')
            for prefix in commands:
                result=subprocess.run(['xfconf-query','-c','xfce4-panel','-p',prefix+'/update-period','-s',str(cfg['panel_interval']*1000)],capture_output=True,text=True)
            status.set_text(f"Preferences saved. Panel refreshes every {cfg['panel_interval']} seconds." if result.returncode==0 else 'Preferences saved; panel interval could not be changed: '+result.stderr)
            update()
        save_button=Gtk.Button(label='Apply display preferences');save_button.connect('clicked',save)
        settings_box.pack_start(save_button,False,False,0)
        settings_box.pack_start(Gtk.Separator(),False,False,0)
        # Brightness uses the active session's standard elogind API; no root helper.
        debounce=[None]
        backs=list(Path('/sys/class/backlight').iterdir())
        if backs:
            back=backs[0];maximum=num(back/'max_brightness');current=num(back/'brightness')
            if maximum and current is not None:
                settings_box.pack_start(Gtk.Label(label='Display brightness',xalign=0),False,False,0)
                scale=Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL,5,100,1)
                scale.set_value(current/maximum*100);scale.set_digits(0);scale.set_value_pos(Gtk.PositionType.RIGHT)
                scale.connect('format-value',lambda widget,value:f'{value:.0f}%')
                settings_box.pack_start(scale,False,False,0)
                debounce=[None]
                def apply_brightness():
                    debounce[0]=None
                    try:
                        bus=Gio.bus_get_sync(Gio.BusType.SYSTEM,None)
                        bus.call_sync('org.freedesktop.login1','/org/freedesktop/login1/session/self',
                          'org.freedesktop.login1.Session','SetBrightness',
                          GLib.Variant('(ssu)',('backlight',back.name,int(maximum*scale.get_value()/100))),
                          None,Gio.DBusCallFlags.NONE,3000,None)
                        status.set_text('Brightness updated.')
                    except GLib.Error as exc: status.set_text('Brightness: '+exc.message)
                    return False
                def brightness_changed(s):
                    if debounce[0]: GLib.source_remove(debounce[0])
                    debounce[0]=GLib.timeout_add(250,apply_brightness)
                scale.connect('value-changed',brightness_changed)
        presentation=Gtk.CheckButton(label='Presentation mode (keep the screen awake)')
        result=subprocess.run(['xfconf-query','-c','xfce4-power-manager','-p','/xfce4-power-manager/presentation-mode'],capture_output=True,text=True)
        presentation.set_active(result.stdout.strip()=='true')
        def set_presentation(w):
            r=subprocess.run(['xfconf-query','-c','xfce4-power-manager','-p','/xfce4-power-manager/presentation-mode','-s',str(w.get_active()).lower()],capture_output=True,text=True)
            status.set_text('Presentation mode updated.' if not r.returncode else r.stderr)
        presentation.get_child().set_line_wrap(True)
        presentation.connect('toggled',set_presentation);settings_box.pack_start(presentation,False,False,0)
        outer.pack_start(status,False,False,0)
        bar=Gtk.Box(spacing=8)
        for caption,command in [('Task Manager',['xfce4-taskmanager']),('Power Settings',['xfce4-power-manager','-c']),('XFCE Settings',['xfce4-settings-manager'])]:
            button=Gtk.Button(label=caption)
            def launch(b,cmd=command):
                try: Gio.Subprocess.new(cmd,Gio.SubprocessFlags.NONE)
                except GLib.Error as exc: status.set_text(exc.message)
            button.connect('clicked',launch);bar.pack_start(button,True,True,0)
        outer.pack_start(bar,False,False,0)
        update();timer[0]=GLib.timeout_add_seconds(cfg['interval'],update)
        win.connect('destroy',lambda w:GLib.source_remove(timer[0]) if timer[0] else None)
        win.show_all()
        def cleanup(*args):
            if debounce[0]: GLib.source_remove(debounce[0])
            CACHE.unlink(missing_ok=True)
        win.connect('destroy',cleanup)
    app.connect('activate',activate);app.run([])
if __name__=='__main__':
    if '--window' in sys.argv: window()
    else: panel()
